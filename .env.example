# URL pública canónica do website (sem barra final). Usada em SEO, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.acailangola.com

# Demonstrações/homologação: 1 bloqueia a indexação (robots.txt + meta robots noindex).
SITE_NOINDEX=

# --- Envio do formulário de contacto (opcional) ---
# Sem RESEND_API_KEY e CONTACT_FROM_EMAIL o formulário NÃO simula envios:
# a API responde 503 e a interface apresenta os e-mails dos departamentos.
# Fornecedor suportado: Resend (https://resend.com). O domínio do remetente deve estar verificado.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Website ACAIL Angola <website@acailangola.com>"

# Opcional: força todos os pedidos para um único destinatário (útil em testes/homologação).
# Se vazio, cada mensagem é encaminhada para o departamento da área de interesse.
CONTACT_OVERRIDE_TO=
