{
  "name": "acail-angola-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website institucional da ACAIL Angola — proposta de reformulação",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
